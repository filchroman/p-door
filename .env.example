# Домен, направленный на VPS (A-запись). Caddy получит для него сертификат.
DOMAIN=vakhta.example.com

# Токен бота из @BotFather (/newbot). Никогда не коммитьте .env.
BOT_TOKEN=123456789:AAAA-your-bot-token

# Имя бота без @ и короткое имя Mini App из /newapp — из них собирается ссылка-приглашение
# https://t.me/<BOT_USERNAME>/<APP_SHORT_NAME>?startapp=<CODE>
BOT_USERNAME=vakhta_bot
APP_SHORT_NAME=game
