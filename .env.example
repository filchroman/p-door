# Домен, направленный на VPS (A-запись). Caddy получит для него сертификат.
DOMAIN=vakhta.example.com

# Токен бота из @BotFather (/newbot). Никогда не коммитьте .env.
BOT_TOKEN=123456789:AAAA-your-bot-token

# Имя бота без @ — для ссылки-приглашения и сообщения с кнопкой «Войти в комнату».
BOT_USERNAME=vakhta_bot

# Короткое имя Mini App из /newapp (необязательно). С ним ссылка-приглашение —
# https://t.me/<BOT_USERNAME>/<APP_SHORT_NAME>?startapp=<CODE>; без него — https://t.me/<BOT_USERNAME>?startapp=<CODE>
# (работает, если в BotFather у бота включён Main Mini App: /mybots → Bot Settings → Configure Mini App).
APP_SHORT_NAME=
